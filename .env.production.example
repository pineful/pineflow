# Legacy EC2 Docker/PostgreSQL PoC only. The AWS Serverless mainline does not use this file.
# Copy to .env.production on the host and keep the copied file out of Git.
POSTGRES_DB=pineflow
POSTGRES_USER=pineflow
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
DATABASE_URL=postgres://pineflow:replace-with-long-random-postgres-password@postgres:5432/pineflow
PINEFLOW_OWNER_KEY=replace-with-long-random-owner-secret
PINEFLOW_ACCESS_TOKEN=replace-with-long-random-access-token
CORS_ORIGIN=
