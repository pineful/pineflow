{
  "name": "pineflow-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "verify": "npm run build && npm run synth && node scripts/verify-template.mjs",
    "check:trend-lens-sources": "node scripts/check-trend-lens-sources.mjs",
    "dynamodb:backup": "node scripts/dynamodb-backup.mjs export",
    "dynamodb:restore": "node scripts/dynamodb-backup.mjs import",
    "dynamodb:backup:validate": "node scripts/dynamodb-backup.mjs validate",
    "diff": "cdk diff",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.258.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "aws-cdk": "^2.1126.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
